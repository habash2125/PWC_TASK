# ─────────────────────────────────────────────────────────────────────────────
# Lens — environment template.  Copy to .env and set OPENAI_API_KEY.
# Nothing in this file is a real secret; every value below is a local-dev
# default that only works inside the compose network.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=dev                       # dev | prod
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000

# ── app-db (Lens's own state; the app role reads and writes here only) ───────
APP_DB_HOST=app-db
APP_DB_PORT=5432
APP_DB_NAME=lens_app
APP_DB_USER=lens_app
APP_DB_PASSWORD=lens_app_dev_pw

# ── analytics-db (the business data: a SQLite file) ───────────────────────────
# The `migrate` service builds it from the vendored Northwind dataset; the API opens it read-only.
# Inside compose the path is on the shared `analytics-data` volume; for local dev use backend/.env.
ANALYTICS_SQLITE_PATH=/app/data/analytics/northwind.db
# data_source.dsn_secret_ref points at this env var name, never at a DSN
ANALYTICS_DSN_SECRET_REF=ANALYTICS_SQLITE_PATH

# ── cache ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://cache:6379/0

# ── auth ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256               # HS256 (dev) | RS256 (prod; set the key paths)
JWT_SECRET=change-me-dev-only-hs256-secret-at-least-32-bytes-long
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=lens
JWT_AUDIENCE=lens-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false               # true behind TLS
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=30

# ── seeded users (dev only; README lists them) ───────────────────────────────
SEED_TENANT_NAME=Lens Demo
SEED_ADMIN_PASSWORD=Admin!Lens2024
SEED_ANALYST_PASSWORD=Analyst!Lens2024
SEED_ANALYST2_PASSWORD=Analyst2!Lens2024
SEED_PARTNER_PASSWORD=Partner!Lens2024

# ── LLM provider (native openai SDK; any OpenAI-compatible endpoint) ─────────
# OpenAI:      LLM_BASE_URL blank, models "gpt-4o" / "gpt-4o-mini"
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1, models "openai/gpt-4o" / "openai/gpt-4o-mini"
OPENAI_API_KEY=sk-REPLACE-ME      # used when LLM_API_KEY is blank
LLM_API_KEY=                      # set only for a non-OpenAI gateway (overrides OPENAI_API_KEY)
LLM_BASE_URL=                     # blank = api.openai.com; set for OpenRouter/Azure/vLLM gateways
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
# model configuration as data — one model per pipeline stage, plus a fallback chain
LLM_MODEL_SCREEN=gpt-4o-mini
LLM_MODEL_AGENT=gpt-4o
LLM_MODEL_GUARD=gpt-4o-mini
LLM_MODEL_NARRATIVE=gpt-4o-mini
LLM_MODEL_GROUPING=gpt-4o-mini
LLM_FALLBACK_MODELS=gpt-4o-mini
LLM_TEMPERATURE_CODE=0
LLM_TEMPERATURE_NARRATIVE=0.2
# USD per 1M tokens, JSON: {"model": [input, output]}
LLM_PRICING_JSON={"gpt-4o":[2.5,10.0],"gpt-4o-mini":[0.15,0.6]}
# extra JSON merged into every request body (gateway knobs); OpenRouter: {"reasoning":{"enabled":false}}
LLM_EXTRA_BODY_JSON={}

# ── guard ────────────────────────────────────────────────────────────────────
# llm    = guard model enforces rules 3/5, parser records shadow verdict (Section 8.2)
# parser = deterministic parser enforces everything (used by refresh, tests, no-key envs)
GUARD_ENFORCER=llm
SQL_MAX_ROWS=5000
SQL_STATEMENT_TIMEOUT_MS=8000

# ── turn budgets ─────────────────────────────────────────────────────────────
TURN_MAX_STEPS=12
TURN_MAX_SQL_RETRIES=4
TURN_TIMEOUT_SECONDS=90
TURN_MAX_TOKENS=60000
DAILY_TURN_CEILING=200
DAILY_TOKEN_CEILING=2000000
DAILY_COST_CEILING_USD=20
PY_EXEC_TIMEOUT_SECONDS=20
PY_EXEC_MEMORY_MB=768
PY_EXEC_CPU_SECONDS=15

# ── dashboards ───────────────────────────────────────────────────────────────
REFRESH_CONCURRENCY=4
QUERY_CACHE_TTL_SECONDS=30

# ── HTTP hardening ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
MAX_REQUEST_BYTES=262144
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_IP_PER_MINUTE=300

# ── observability ────────────────────────────────────────────────────────────
TRACE_RETENTION_DAYS=30
METRICS_ENABLED=true

# ── LangSmith (optional; third-party LLM tracing — https://smith.langchain.com) ──
# Blank LANGSMITH_API_KEY = disabled (default). When set, every model call is also
# logged as a run there, alongside the in-app tracer at /api/v1/traces.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lens
LANGSMITH_ENDPOINT=
